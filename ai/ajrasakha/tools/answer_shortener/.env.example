# Required Samagama credential for MiniMax-M3. Never commit a real key.
SAMAGAMA_API_KEY=your_samagama_api_key_here
SAMAGAMA_CHAT_COMPLETIONS_URL=https://samagama.in/platform/proxy/v1/chat/completions

# Default source-segment ranking and fallback-compression model.
ANSWER_SHORTENER_MODEL=MiniMax-M3
# MiniMax-M3 can spend substantial time on internal reasoning for long answers.
SAMAGAMA_TIMEOUT_SECONDS=120
SAMAGAMA_MAX_RETRIES=2

# One initial ranking attempt plus up to two corrective attempts.
ANSWER_SHORTENER_REWRITE_ATTEMPTS=3
# MiniMax-M3 needs room for internal reasoning before returning its final text.
# Keep this at 8192 or higher for reliable source-segment ranking.
ANSWER_SHORTENER_MAX_OUTPUT_TOKENS=32768

# Optional locally. Set this in deployment to require X-API-Key on the shorten route.
ANSWER_SHORTENER_API_KEY=

# Docker host port; compose publishes it on 127.0.0.1 only.
ANSWER_SHORTENER_HOST_PORT=8112
