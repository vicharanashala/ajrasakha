# Jev (TypeSafe) provider switch — NO SECRETS IN THIS FILE.
# Every integration point defaults to the existing model. Nothing changes unless a switch below is set to "jev".
# Direct TypeSafe is the default. Credentials are read from the environment only.
JEV_GATEWAY=typesafe                  # typesafe | openrouter
# TYPESAFE_API_KEY=<set in your secret store / local .env>
# For OpenRouter instead: JEV_GATEWAY=openrouter and OPENROUTER_API_KEY=<key>

# --- global switches ---------------------------------------------------------
JEV_PROVIDER=current                 # current | jev   (default for every task)
JEV_FALLBACK=current                 # current = call the existing model when Jev fails / is low-confidence
                                     # default = use the function's existing deterministic failure default
JEV_MODEL=jev-latest                 # direct TypeSafe model id
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_TIMEOUT_S=10
JEV_MIN_CONFIDENCE=0.0               # global; choice confidence, or max(p,1-p) for yes/no answers
JEV_NOUL_THRESHOLD=0.5               # probability of "yes" at/above which a yes/no decision is true

# --- per-task overrides (JEV_PROVIDER_<TASK>, JEV_MIN_CONFIDENCE_<TASK>) ----------
# tasks: CROP_REQUIREMENT LANGUAGE GOLDEN_RELEVANCE GOLDEN_CLASSIFY GOLDEN_TIEBREAK PENDING_DUPLICATE
#        SIMILAR_FILTER SIMILAR_CLASSIFY SIMILAR_TIEBREAK SAFETY AGRI_RELEVANCE WEATHER_INTENT
#        WEATHER_CLASSIFIER MANDI_INTENT ANSWER_SUFFICIENCY ACC_TOOLS SHORTENER_RANKING PLANNER_DECISIONS
# JEV_PROVIDER_CROP_REQUIREMENT=current
# JEV_MIN_CONFIDENCE_CROP_REQUIREMENT=0.8

# planner integration: shadow (compare + trace only, default) | override (Jev replaces decision fields)
# JEV_PLANNER_MODE=shadow

# --- tracing ---------------------------------------------------------------
# JEV_TRACE_PATH=/var/log/ajrasakha/jev_trace.jsonl   # one JSON line per Jev call; farmer text NOT recorded by default
# JEV_TRACE_INCLUDE_TEXT=0
