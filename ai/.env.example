# =============================================================================
# AjraSakha LangGraph API - Environment Variables
# =============================================================================
# This file documents the environment variables used by the LangGraph API.
# Copy this file to .env and fill in the values.
#
# IMPORTANT: For production deployments on GCP, ensure TAILSCALE_AUTHKEY is set
# so the container can connect to internal services on the tailnet (100.100.x.x).
# =============================================================================

# =============================================================================
# Tailscale Networking
# =============================================================================
# Required for reaching internal services on the tailnet (100.100.x.x).
# The Dockerfile starts tailscaled in userspace networking mode, exposing a
# SOCKS5 proxy on localhost:1055. All tailnet-bound traffic is routed through it.
#
# - TAILSCALE_AUTHKEY: Auth key (tskey-auth-...) from
#                      https://login.tailscale.com/admin/settings/keys
#                      Use an EPHEMERAL key for containers.
# - TS_HOSTNAME:       Hostname for this instance on the tailnet
# - TS_DERP_REGION:    Lock to a specific DERP region (e.g., 7 for Mumbai/India)
#                      Leave empty for auto-selection.
# - SKIP_TAILSCALE_STATUS: Set to "true" to skip Tailscale checks (local dev without tailnet)

TAILSCALE_AUTHKEY=tskey-auth-YOUR_KEY_HERE
TS_HOSTNAME=ajrasakha-langgraph
TS_DERP_REGION=
SKIP_TAILSCALE_STATUS=false

# =============================================================================
# OpenAI Configuration
# =============================================================================
OPENAI_API_KEY=dummy
OPENAI_BASE_URL=http://100.100.108.100:8080/v1

# OpenWeather API Configuration
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Golden RAG Tool Configuration
GOLDEN_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
GOLDEN_EMBEDDING_ENDPOINT=http://100.100.108.43:6001/embed
GOLDEN_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
GOLDEN_MONGODB_INDEX=review_questions_vector_index
GOLDEN_MONGODB_DATABASE=agriai
GOLDEN_MONGODB_COLLECTION=questions
GOLDEN_MONGODB_SEARCH_INDEX=review_questions_search_index
GOLDEN_CROP_MASTER_COLLECTION=crop_master
# Literal Python dict module (Mongo sync → crop_chemical_name.py → memory). Rebuild:
# python -m ajrasakha.agents.build_crop_master_dictionary
GOLDEN_CROP_CHEMICAL_NAME_PATH=ajrasakha/agents/crop_chemical_name.py

# Redis (docker-compose sets socket_timeout=10 for BLPOP/SSE; required when REDIS_BROKER_ENABLED=true)
# REDIS_URL=redis://redis:6379/0?socket_timeout=10
# REDIS_BROKER_ENABLED=false  # single-container dev: in-memory broker + local executor (no stream hang)

# Per-thread log files: logs/{thread_id}.txt (disable with THREAD_FILE_LOGGING=false)
THREAD_LOG_DIR=logs
THREAD_FILE_LOGGING=true
# MongoDB thread logs (agriai.langgraph_log): one document per thread_id (_id).
#   turns[]  — per farmer message: user_message, bot_message, outcome, log_text
#   full_logs — full local .txt snapshot (updated async each turn)
# (no top-level text field; all logs live in turns[n].log_text)
THREAD_LOG_MONGODB=true
THREAD_LOG_MONGODB_COLLECTION=langgraph_log
# Async by default (non-blocking). Set THREAD_LOG_MONGO_SYNC=true only for debugging.
# THREAD_LOG_MONGO_SYNC=false
# THREAD_LOG_MONGO_WORKERS=4

# Agricultural API Base URLs
AGMARKNET_BASE_URL=https://api.agmarknet.gov.in/v1
ENAM_BASE_URL=https://enam.gov.in/web/Ajax_ctrl

# IMD Weather Service Configuration
IMD_CITY_BASE=http://100.100.108.101:18080/city/api
IMD_MAUSAM_BASE=http://100.100.108.101:18080/mausam/api

# WhatsApp & Graph Database Configurations
WHATSAPP_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/whatsapp
DATABASE_URI=postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# Gemma Model Configuration
GEMMA_MODEL=google/gemma-4-26B-A4B-it
GEMMA_BASE_URL=http://100.100.108.44:8013/v1

# Remote MCP / Golden API
REMOTE_IP=100.100.108.44
# Base URL only (not .../v1/gdb/search). Docker compose often maps 8110:8005.
GOLDEN_API_URL=http://100.100.108.41:8110
GOLDEN_API_TIMEOUT_S=120
GOLDEN_RAG_TOP_K=5
GOLDEN_GEMMA_TIMEOUT_S=30
# LLM tie-breaker when this many or more share SAME_INTENT or COVERED_BY_CONTEXT (default 2)
GOLDEN_TIE_BREAK_MIN=2

# Reviewer question channel when LangGraph configurable.question_source is not set
QUESTION_SOURCE=AJRASAKHA

# Local testing: LOCAL=true runs every request without a user id as LOCAL_USER_ID
# (profile location, reviewer upload and user_details writes all use that user).
LOCAL=false
LOCAL_USER_ID=

# Official Local Government Directory (LGD) normalization for ACC locations
# Generate an API key at https://data.gov.in/
LGD_API_KEY=
LGD_STATES_API_URL=https://api.data.gov.in/resource/a71e60f0-a21d-43de-a6c5-fa5d21600cdb
LGD_DISTRICTS_API_URL=https://api.data.gov.in/resource/37231365-78ba-44d5-ac22-3deec40b9197
LGD_CACHE_TTL_SECONDS=86400
LGD_REQUEST_TIMEOUT_SECONDS=10
