#!/bin/bash
# Starts LangGraph API after Tailscale is ready

# Skip Tailscale check if requested
if [ "${SKIP_TAILSCALE_STATUS:-false}" != "true" ]; then
    i=0
    while [ $i -lt 20 ]; do
        if [ -S /var/run/tailscale/tailscaled.sock ] && \
           tailscale status >/dev/null 2>&1; then
            break
        fi
        i=$((i + 1))
        sleep 1
    done

    if [ $i -ge 20 ]; then
        echo "WARNING: Tailscale not ready, proceeding anyway"
    fi

    # Wait for SOCKS5 proxy
    if [ -f /app/s6-scripts/wait-for-socks5.py ]; then
        python3 /app/s6-scripts/wait-for-socks5.py || true
    fi
fi

# Start LangGraph API using aegra serve
cd /app
source .venv/bin/activate
exec aegra serve