{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build",
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ESNext"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowArbitraryExtensions": false,
    "incremental": true,
    "types": ["node", "express"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "inlineSources": true
  },
  "exclude": ["build", "**/*.test.ts", "tests/**"]
}
