# ---- Database ---------------------------------------------------------------
# MongoDB Atlas connection string. Seed DBs (farmer_feedback, gdb_gap_detector)
# are READ ONLY; all outputs go to OUTPUT_DB.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=hackathon
OUTPUT_DB=ace_insights

# ---- Profile ----------------------------------------------------------------
# prod  -> production defaults (30-day window, clusters of 3+)
# demo  -> looser thresholds so the ~7 MB hackathon sample still yields output
ACE_PROFILE=demo

# ---- Gap detector (Project 6) -----------------------------------------------
# EMBEDDING_BACKEND=sentence-transformers      # or "hash" (tests / CI, no model download)
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# CLUSTER_DISTANCE_THRESHOLD=0.35              # cosine distance for agglomerative clustering
# MIN_CLUSTER_SIZE=2
# GAP_REPORT_PERIOD_DAYS=90
# GAP_TOP_N=20
# COVERAGE_GOOD=0.60                           # coverage_score >= this -> good
# COVERAGE_PARTIAL=0.30                        # >= this -> partial, else gap

# ---- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
FARMER_KEY_SALT=change-me
