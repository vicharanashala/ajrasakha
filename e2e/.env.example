# ── Reviewer System E2E · environment template ──────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# Base URL of the Reviewer System under test (staging by default).
E2E_BASE_URL=https://desk.vicharanashala.ai

# API base the backend serves (used by setup/cleanup helpers that need raw
# endpoints for verification or fixture creation).
E2E_API_BASE_URL=https://desk.vicharanashala.ai/api

# ── Admin (user management, data processing, manage agents) ─────────────
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# ── Moderator (queue, allocate, review, approve / push to GDB) ──────────
E2E_MODERATOR_EMAIL=
E2E_MODERATOR_PASSWORD=

# ── Expert (My Queue, submit/reroute responses) ─────────────────────────
E2E_EXPERT_EMAIL=
E2E_EXPERT_PASSWORD=

# ── Optional: fresh account for signup/reset flows (provisioned manually) ──
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=

# ── Optional overrides (defaults are fine) ──────────────────────────────
# E2E_ADMIN_STORAGE_STATE=.auth/admin.json
# E2E_MODERATOR_STORAGE_STATE=.auth/moderator.json
# E2E_EXPERT_STORAGE_STATE=.auth/expert.json

# Run against a local backend/frontend instead of staging (dev workflow):
# E2E_BASE_URL=http://localhost:5173
# E2E_API_BASE_URL=http://localhost:8080/api
