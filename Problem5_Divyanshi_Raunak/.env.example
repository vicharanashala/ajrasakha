# =============================================================================
# AjraSakha Agri-Intel - Environment Variables Configuration
# =============================================================================
# Copy this file to .env before starting the services:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI & Uvicorn)
# -----------------------------------------------------------------------------
# Project branding and title
PROJECT_NAME="AJRASAKHA PS-5 FEEDBACK SUITE"

# Host and port for the FastAPI application server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# MongoDB Database Configuration
# Default local instance or MongoDB Atlas URI (e.g. mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=ajrasakha_db

# Statistical Flagging Pipeline Parameters
# FLAG_HELPFUL_THRESHOLD: Helpful ratio cutoff (< 0.60 = below 60% flags entry)
FLAG_HELPFUL_THRESHOLD=0.60
# FLAG_MIN_RESPONSES: Minimum sample size of responses before evaluating
FLAG_MIN_RESPONSES=10

# APScheduler Daily Cron Job (Flagging Scan)
# Scheduled daily run time in Indian Standard Time (Asia/Kolkata timezone)
# Default is 2:00 AM IST
CRON_FLAGGING_HOUR=2
CRON_FLAGGING_MINUTE=0

# Agro-Chrono Scheduling Window (Evening Leisure Hours for Farmer Nudges)
# CHRONO_LEISURE_START_HOUR: 19 = 7:00 PM IST
CHRONO_LEISURE_START_HOUR=19
# CHRONO_LEISURE_END_HOUR: 21 = 9:00 PM IST
CHRONO_LEISURE_END_HOUR=21
# FEEDBACK_DAY_TIMEOUT_MINS: Daytime timeout (minutes) before scheduling evening nudge
FEEDBACK_DAY_TIMEOUT_MINS=120

# NVIDIA Build API (NIM) Configuration
# Get your API key from https://build.nvidia.com
# Leave empty to automatically use verified ICAR/KVK agronomic rules fallback
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Supported models include: nvidia/nemotron-3.5-lightning-30b-a3b, meta/llama-3.1-70b-instruct, etc.
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Twilio WhatsApp API Configuration
# Get your credentials from https://console.twilio.com
# Leave empty to automatically run in Sandbox / Simulation mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sender number (sandbox default is whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886


# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite + React)
# -----------------------------------------------------------------------------
# All frontend environment variables exposed to Vite must begin with VITE_

# Base API endpoint URL accessed by frontend fetch client
# Default uses '/api' which is reverse-proxied by Vite to the backend in development
VITE_API_BASE_URL=/api

# Target backend server URL used by Vite development dev proxy
VITE_BACKEND_URL=http://localhost:8000

# Vite development server port
VITE_DEV_PORT=5173

# Application branding / title
VITE_APP_TITLE="AjraSakha Agri-Intel"
