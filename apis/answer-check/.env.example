# Required: real model calls fail without this. Never commit the real value.
MINIMAX_API_KEY=

# The model server and the exact model name it serves (a wrong name gives a 404).
# MINIMAX_URL=
# MINIMAX_MODEL=MiniMax-M3

# Optional. true skips real model calls and returns canned PASS results (tests only).
USE_MOCK_LLM=false

# Optional. Reads the answer with the model to find chemical names the plain
# lookup misses. On by default; it falls back to the lookup if the model fails.
# CHEMICAL_MODEL_CHECK=true

# Optional tuning, safe defaults if left unset.
# PIPELINE_WORKERS=8
# PIPELINE_RETRY_ROUNDS=5
# LOG_LEVEL=INFO
# ZOHO_API_BASE=https://workdrive.zohoexternal.in/public/api/v1
