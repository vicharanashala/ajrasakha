# Required -- real model calls will fail without this. Never commit the
# real value.
MINIMAX_API_KEY=

# Optional. true skips real model calls and returns canned PASS results --
# used by the automated tests, not for real scoring. Defaults to false.
USE_MOCK_LLM=false

# Optional tuning, both have safe defaults if left unset.
# PIPELINE_WORKERS=8
# PIPELINE_RETRY_ROUNDS=5
