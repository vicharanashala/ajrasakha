# Option A (default) - MiniMax's public API. No Tailscale needed.
#   MINIMAX_BASE_URL=https://api.minimax.io/v1
#   MINIMAX_CHAT_PATH=/text/chatcompletion_v2
#   MINIMAX_MODEL=MiniMax-M2.7
#
# Option B - the self-hosted model on the tailnet, OpenAI-compatible path.
# Needs TAILSCALE_AUTHKEY set below - llm_client.py routes this one host
# through the local Tailscale SOCKS proxy automatically when one is
# actually listening (same tailnet-host detection as
# apis/writing_assistant/assistant/llm_client.py's _is_tailnet_host, plus
# a live check so a machine already tailnet-joined directly - no local
# SOCKS hop running - still connects straight through):
#   MINIMAX_BASE_URL=http://100.100.108.41:8001/v1
#   MINIMAX_CHAT_PATH=/chat/completions
#   MINIMAX_MODEL=MiniMaxAI/MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_CHAT_PATH=/text/chatcompletion_v2
MINIMAX_TIMEOUT_SECONDS=90
MINIMAX_SEED=0

# Only used for MINIMAX_BASE_URL Option B above (a 100.x tailnet address) -
# see scripts/start.sh. Leave unset for Option A; the container still boots
# fine without it (fails open, same as apis/writing_assistant/scripts/start.sh).
# Must be a REUSABLE, EPHEMERAL Tailscale auth key - a single-use key only
# authenticates the first container instance and fails on every one after it.
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=agriculture-classifier
