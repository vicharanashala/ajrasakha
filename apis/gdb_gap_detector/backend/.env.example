# Real DB: mongodb+srv://<user>:<password>@<host>/  (read on `questions`, write on gdb_gap_* collections)
MONGO_URI=mongomock://
MONGO_DB=agriai
QUESTIONS_COLLECTION=questions
DISCLAIMER_SOURCES=AJRASAKHA,WHATSAPP
RESOLVED_STATUSES=closed
LOOKBACK_DAYS=90
EMBEDDING_BACKEND=auto
REPORT_TOP_N=20
ENABLE_SCHEDULER=1
SOURCE_MODE=questions   # or disclaimer_logs (+ SOURCE_DB, SOURCE_COLLECTION, GDB_COLLECTION, OUT_DB, AS_OF=latest)
REPORT_INTERVAL_HOURS=2   # pipeline re-runs every N hours
REPORT_TZ=Asia/Kolkata
