# Required - Anthropic API key used for domain classification, angle
# selection, and farmer-friendly version generation
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional - overrides the model used by ai/ajrasakha/ffv/scripts/generate_ffvs.py
# (defaults to claude-sonnet-4-5 if unset)
CLAUDE_MODEL=claude-sonnet-4-5
