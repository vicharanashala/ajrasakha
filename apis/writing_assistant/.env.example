# "local" for development/testing, "gcs" in production. No default - must
# be set explicitly, never guessed.
REFERENCE_DATA_SOURCE=local

# Only used when REFERENCE_DATA_SOURCE=local. Point this at your own local
# copy of the four Golden Database CSVs. Never commit the real files or this
# path with a real value.
REFERENCE_DATA_DIR=

# Only used when REFERENCE_DATA_SOURCE=gcs (production - not implemented yet,
# no GCS bucket or service account has been provisioned).
REFERENCE_GCS_BUCKET=
REFERENCE_GCS_PREFIX=reference-data
REFERENCE_RELEASE_ID=

# Same MiniMax env var names already used elsewhere in this repo
# (ai/ajrasakha/agents/config.py, backend/src/config/ai.ts).
#
# Option A (RECOMMENDED, as of the team's response-time requirement) -
# the self-hosted model on the tailnet, OpenAI-compatible path (confirmed
# by ai/ajrasakha/agents/config.py's get_minimax_chat_model). Needs
# TAILSCALE_AUTHKEY set below (or the host machine already tailnet-joined
# for local dev) - llm_client.py routes this one host through the local
# Tailscale SOCKS proxy automatically when running in a container (same
# tailnet-host detection as backend/src/bootstrap/tailnetProxy.ts).
# Live-measured, not assumed: 2-7s per call typical across 3 real test
# batches (median 3.4s), comfortably under the team's 20s target -
# MINIMAX_TIMEOUT_SECONDS defaults to 20 accordingly. One rare ~90s
# reasoning-model stall was observed in ~66 real calls - the 20s cap
# just fails that case faster, it doesn't eliminate the rare stall:
#   MINIMAX_BASE_URL=http://100.100.108.41:8001/v1
#   MINIMAX_CHAT_PATH=/chat/completions   (the default - can be omitted)
#   MINIMAX_MODEL=MiniMaxAI/MiniMax-M2.7
#
# Option B - MiniMax's own public API. No Tailscale needed - this is what
# every real test report before the self-hosted switch actually ran
# against (M3, not M2.7). Much slower in practice (10-90+s/call observed)
# - override MINIMAX_TIMEOUT_SECONDS back up to 90 if you use this path:
#   MINIMAX_BASE_URL=https://api.minimax.io/v1
#   MINIMAX_CHAT_PATH=/text/chatcompletion_v2
#   MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=
MINIMAX_CHAT_PATH=/chat/completions
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMaxAI/MiniMax-M2.7

# Only used for MINIMAX_BASE_URL Option A above (a 100.x tailnet
# address) - see scripts/start.sh. Leave unset for Option B; the
# container still boots fine without it (fails open, same as
# backend/scripts/start.sh). Must be a REUSABLE, EPHEMERAL Tailscale
# auth key - a single-use key only authenticates the first container
# instance and fails on every one after it.
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=writing-assistant
# Fixed seed on every call, to reduce (not guarantee-eliminate) run-to-run
# sampling variance on identical input - see Revision 14, ISS-04.
MINIMAX_SEED=0

# The same read-only staging Mongo cluster apis/chemical_detector reads
# from - connected to directly, in-process, not over HTTP to that sibling
# service (Writing Assistant Build Plan, Revision 14). Same connection
# string as apis/chemical_detector/.env's CHEMICAL_DB_URL.
CHEMICAL_DB_URL=
CHEMICAL_DB_NAME=agriai
CHEMICAL_COLLECTION_NAME=crop_master
