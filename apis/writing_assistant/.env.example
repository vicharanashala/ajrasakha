# Public Gemini API - team-provided access to gemini-3.8-flash for this
# endpoint. Replaces the self-hosted MiniMax-M2.7 client this service used
# before. A directly-reachable public HTTPS API - no Tailscale/tailnet
# needed to reach it, unlike the old self-hosted model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Carried over unchanged from the self-hosted MiniMax tuning (same
# mechanism: concurrency semaphore, these timeout budgets, hedged
# requests - see llm_client.py) at the team's request. These specific
# NUMBERS were derived against MiniMax's own serving stack, not
# Gemini's - re-validate once this is live-tested against real Gemini
# traffic.
GEMINI_TIMEOUT_SECONDS=20
# classify_all_steps_coverage's own budget - one call scores the WHOLE
# 10-step checklist at once, run up to 3x as a call-level majority vote
# (~2-3 calls per request, not the ~30 single-step calls this used to take).
# This is the floor for a draft under 1,500 characters; it scales up to
# GEMINI_COVERAGE_MAX_TIMEOUT_SECONDS for a longer one - see config.py.
GEMINI_COVERAGE_TIMEOUT_SECONDS=30
GEMINI_COVERAGE_MAX_TIMEOUT_SECONDS=70
# generate_polish (whole-document, with a per-section fallback) and
# check_meaning_preserved_batch's own budget - each runs once per request
# in the common case, not once per section.
GEMINI_POLISH_TIMEOUT_SECONDS=30

# Fixed seed on every call, to reduce (not guarantee-eliminate) run-to-run
# sampling variance on identical input - see Revision 14, ISS-04. Not yet
# verified live that Gemini's own "seed" field has the same stabilizing
# effect MiniMax showed.
GEMINI_SEED=0

# Process-wide cap on real concurrent calls (primary + hedge) across every
# request - carried over from the MiniMax tuning (cap of 5, derived from
# that model's own vLLM /metrics under load). Re-tune against Gemini's
# actual rate limit once this is live-tested - see config.py.
GEMINI_MAX_CONCURRENT_CALLS=5

# The same read-only staging Mongo cluster apis/chemical_detector reads
# from - connected to directly, in-process, not over HTTP to that sibling
# service (Writing Assistant Build Plan, Revision 14). Same connection
# string as apis/chemical_detector/.env's CHEMICAL_DB_URL. Unaffected by
# the Gemini switch.
CHEMICAL_DB_URL=
CHEMICAL_DB_NAME=agriai
CHEMICAL_COLLECTION_NAME=crop_master

# Shared secret the caller must send as the X-API-Key header on
# /polish-draft (answer_shortener's ANSWER_SHORTENER_API_KEY uses the
# same scheme). Left empty, auth is OFF - the service runs exactly as it
# does today. Set this once the service is reachable from outside a
# trusted network (e.g. deployed publicly on Render).
WRITING_ASSISTANT_API_KEY=
