# ===========================================================================
# Ajrasakha Live Weather API - Environment Configuration
# ===========================================================================

# Server binding port (Cloud Run will inject $PORT automatically)
PORT=8085
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Annam Weather Station (WS Nearest Sensors)
# ---------------------------------------------------------------------------
WS_NEAREST_SENSORS_BASE_URL=https://5mqwg03znl.execute-api.us-east-1.amazonaws.com
WS_MAX_DISTANCE_KM=10.0
WS_TIMEOUT_SECONDS=6.0

# ---------------------------------------------------------------------------
# IMD Weather Mirror Service
# ---------------------------------------------------------------------------
# In production on Tailscale: http://100.100.108.101:18080/city/api
# When deployed to Cloud Run with Tailscale, requests to 100.x are routed
# automatically via socks5h://localhost:1055.
IMD_CITY_BASE=http://100.100.108.101:18080/city/api
IMD_TIMEOUT_SECONDS=6.0

# ---------------------------------------------------------------------------
# Tailscale (Optional - mirrors writing_assistant)
# ---------------------------------------------------------------------------
# Needed when deployed in a standalone container to reach 100.100.108.101.
# Must be a REUSABLE, EPHEMERAL auth key.
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=live-weather-api
TAILNET_SOCKS_PROXY=socks5h://localhost:1055

# ---------------------------------------------------------------------------
# Caching Configuration
# ---------------------------------------------------------------------------
WEATHER_CACHE_TTL_SECONDS=300.0
FALLBACK_MAX_DISTANCE_KM=50.0
WEATHER_CACHE_DIR=cache

