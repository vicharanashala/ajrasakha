# Mongo (same DB as the Mandi v2 scraper)
MONGO_URI=mongodb://localhost:27017
MANDI_DB_NAME=
V2_COLLECTION_PREFIX=v2_

PORT=8086
LOG_LEVEL=INFO

# Optional tuning
MARKET_STALE_AFTER_DAYS=3
MARKET_NEARBY_MAX_MANDIS=200
MARKET_MONGO_MAX_TIME_MS=10000

# Secret key(s) clients must send in the X-API-Key header. Comma-separated to allow rotation.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
